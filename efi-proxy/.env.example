PORT=3000

# Segredo compartilhado com as Edge Functions do Supabase (e para o proxy chamar efi-webhook)
PROXY_SECRET=gere_aqui_uma_string_aleatoria_forte

# URL da Edge Function efi-webhook (proxy encaminha o POST da Efi para cá)
SUPABASE_WEBHOOK_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/efi-webhook

# Credenciais Efi Bank
EFI_CLIENT_ID=seu_client_id
EFI_CLIENT_SECRET=seu_client_secret
EFI_PIX_KEY=sua_chave_pix_cadastrada
EFI_CERT_BASE64=conteudo_base64_do_arquivo_p12
EFI_CERT_PASSPHRASE=senha_do_p12_se_houver
EFI_SANDBOX=true
